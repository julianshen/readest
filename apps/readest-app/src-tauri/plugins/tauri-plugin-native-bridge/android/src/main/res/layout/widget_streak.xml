<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:gravity="center">

    <TextView
        android:id="@+id/w_streak_days"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:textColor="#111827"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <View android:id="@+id/w_bar0" android:layout_width="10dp" android:layout_height="wrap_content" android:layout_marginEnd="3dp" />
        <View android:id="@+id/w_bar1" android:layout_width="10dp" android:layout_height="wrap_content" android:layout_marginEnd="3dp" />
        <View android:id="@+id/w_bar2" android:layout_width="10dp" android:layout_height="wrap_content" android:layout_marginEnd="3dp" />
        <View android:id="@+id/w_bar3" android:layout_width="10dp" android:layout_height="wrap_content" android:layout_marginEnd="3dp" />
        <View android:id="@+id/w_bar4" android:layout_width="10dp" android:layout_height="wrap_content" android:layout_marginEnd="3dp" />
        <View android:id="@+id/w_bar5" android:layout_width="10dp" android:layout_height="wrap_content" android:layout_marginEnd="3dp" />
        <View android:id="@+id/w_bar6" android:layout_width="10dp" android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_minutes_today"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="11sp"
        android:textColor="#6b7280" />
</LinearLayout>
