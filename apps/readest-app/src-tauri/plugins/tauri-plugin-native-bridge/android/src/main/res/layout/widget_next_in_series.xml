<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:gravity="center_horizontal">

    <ImageView
        android:id="@+id/w_cover"
        android:layout_width="64dp"
        android:layout_height="88dp"
        android:scaleType="centerCrop"
        android:contentDescription="@string/widget_cover_desc" />

    <TextView
        android:id="@+id/w_series"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:gravity="center"
        android:textSize="12sp"
        android:textColor="#111827"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_finished_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:gravity="center"
        android:textSize="10sp"
        android:textColor="#6b7280" />

    <TextView
        android:id="@+id/w_next_pill"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/w_next_pill"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:textSize="11sp"
        android:textColor="#ffffff"
        android:textStyle="bold" />
</LinearLayout>
